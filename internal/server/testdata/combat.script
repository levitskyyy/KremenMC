# Damage pipeline (victim.hurtServer)
run z_generic hurt=minecraft:generic/5
run z_mob hurt=minecraft:mob_attack/5/zombie
run z_iframes hurt=minecraft:mob_attack/5/zombie hurt=minecraft:mob_attack/3/zombie hurt=minecraft:mob_attack/8/zombie inv=11 hurt=minecraft:mob_attack/9/zombie inv=10 hurt=minecraft:mob_attack/2/zombie
run z_kill vhealth=3 hurt=minecraft:player_attack/5/player
run p_bare victim=player hurt=minecraft:mob_attack/6/zombie
run p_iron victim=player armor=head/minecraft:iron_helmet,chest/minecraft:iron_chestplate,legs/minecraft:iron_leggings,feet/minecraft:iron_boots hurt=minecraft:mob_attack/10/zombie
run p_iron40 victim=player armor=head/minecraft:iron_helmet,chest/minecraft:iron_chestplate,legs/minecraft:iron_leggings,feet/minecraft:iron_boots hurt=minecraft:generic/40
run p_dia4 victim=player armor=head/minecraft:diamond_helmet,chest/minecraft:diamond_chestplate,legs/minecraft:diamond_leggings,feet/minecraft:diamond_boots hurt=minecraft:generic/4
run p_dia30 victim=player armor=head/minecraft:diamond_helmet,chest/minecraft:diamond_chestplate,legs/minecraft:diamond_leggings,feet/minecraft:diamond_boots hurt=minecraft:generic/30
run p_neth30 victim=player armor=head/minecraft:netherite_helmet,chest/minecraft:netherite_chestplate,legs/minecraft:netherite_leggings,feet/minecraft:netherite_boots hurt=minecraft:generic/30
run p_prot victim=player armor=head/minecraft:diamond_helmet+minecraft:protection@4,chest/minecraft:diamond_chestplate+minecraft:protection@4,legs/minecraft:diamond_leggings+minecraft:protection@4,feet/minecraft:diamond_boots+minecraft:protection@4 hurt=minecraft:generic/30
run p_prot2 victim=player armor=chest/minecraft:iron_chestplate+minecraft:protection@2 hurt=minecraft:generic/10
run p_fireprot victim=player armor=chest/minecraft:iron_chestplate+minecraft:fire_protection@4,legs/minecraft:iron_leggings+minecraft:fire_protection@3 hurt=minecraft:in_fire/10
run p_blastprot victim=player armor=chest/minecraft:iron_chestplate+minecraft:blast_protection@4 hurt=minecraft:explosion/20
run p_projprot victim=player armor=chest/minecraft:iron_chestplate+minecraft:projectile_protection@4 hurt=minecraft:arrow/9
run p_magic victim=player armor=chest/minecraft:diamond_chestplate+minecraft:protection@4 hurt=minecraft:magic/6
run p_res1 victim=player veffect=minecraft:resistance@0 hurt=minecraft:generic/10
run p_res2 victim=player veffect=minecraft:resistance@1 armor=chest/minecraft:iron_chestplate hurt=minecraft:generic/10
run p_res5 victim=player veffect=minecraft:resistance@4 hurt=minecraft:generic/10
run p_abs victim=player vabs=4 hurt=minecraft:generic/6
run p_abs2 victim=player vabs=8 armor=chest/minecraft:iron_chestplate hurt=minecraft:generic/6
run p_easy victim=player diff=easy hurt=minecraft:mob_attack/10/zombie
run p_easy2 victim=player diff=easy hurt=minecraft:mob_attack/1/zombie
run p_hard victim=player diff=hard hurt=minecraft:mob_attack/10/zombie
run p_hard_env victim=player diff=hard hurt=minecraft:generic/10
run p_fall3 victim=player fall=3
run p_fall4 victim=player fall=4
run p_fall105 victim=player fall=10.5
run p_fallff victim=player armor=feet/minecraft:diamond_boots+minecraft:feather_falling@4 fall=20
run p_falljump victim=player veffect=minecraft:jump_boost@1 fall=6
run z_fall victim=minecraft:zombie fall=8
run p_shield victim=player block hurt=minecraft:mob_attack/5/zombie
run p_shield_back victim=player vyaw=0 block hurt=minecraft:mob_attack/5/zombie
run p_totem victim=player armor=mainhand/minecraft:totem_of_undying hurt=minecraft:generic/100
