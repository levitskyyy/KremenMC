# Melee (attacker.attack(victim)); attacker at 0.5,101,0.5 facing +z.
run m_fist attack
run m_dsword weapon=minecraft:diamond_sword attack
run m_dsword_cd5 weapon=minecraft:diamond_sword cooldown=5 attack
run m_dsword_cd10 weapon=minecraft:diamond_sword cooldown=10 attack
run m_daxe weapon=minecraft:diamond_axe attack
run m_daxe_cd weapon=minecraft:diamond_axe cooldown=12 attack
run m_crit weapon=minecraft:diamond_sword crit attack
run m_crit_low weapon=minecraft:diamond_sword crit cooldown=10 attack
run m_sprint weapon=minecraft:diamond_sword sprint attack
run m_sprint_cd weapon=minecraft:diamond_sword sprint cooldown=4 attack
run m_sharp weapon=minecraft:diamond_sword+minecraft:sharpness@5 attack
run m_sharp_cd weapon=minecraft:diamond_sword+minecraft:sharpness@5 cooldown=6 attack
run m_smite weapon=minecraft:iron_sword+minecraft:smite@5 attack
run m_bane weapon=minecraft:iron_sword+minecraft:bane_of_arthropods@5 victim=minecraft:spider attack
run m_kb2 weapon=minecraft:iron_sword+minecraft:knockback@2 attack
run m_fire weapon=minecraft:iron_sword+minecraft:fire_aspect@2 attack
run m_strength weapon=minecraft:iron_sword aeffect=minecraft:strength@1 attack
run m_weak aeffect=minecraft:weakness@0 attack
run m_sweep weapon=minecraft:diamond_sword extra=1.5,101,2.5;-0.5,101,2.5;0.5,101,5.5 attack
run m_sweep3 weapon=minecraft:diamond_sword+minecraft:sweeping_edge@3 extra=1.5,101,2.5;-0.5,101,2.5 attack
run m_angle weapon=minecraft:stone_sword ayaw=-45 vpos=2.5,101,2.5 attack
run m_angle2 weapon=minecraft:stone_sword ayaw=-45 vpos=2.0,101,1.0 attack
run m_pvp victim=player attack
run m_pvp_neth weapon=minecraft:netherite_sword sprint victim=player armor=head/minecraft:netherite_helmet,chest/minecraft:netherite_chestplate,legs/minecraft:netherite_leggings,feet/minecraft:netherite_boots attack
run m_pvp_shield weapon=minecraft:diamond_sword victim=player block attack
run m_pvp_axe_shield weapon=minecraft:diamond_axe victim=player block attack
run m_iframe weapon=minecraft:diamond_sword attack attack
run m_trident weapon=minecraft:trident attack
run m_mace_fall weapon=minecraft:mace crit attack
run m_cow weapon=minecraft:wooden_sword victim=minecraft:cow attack
