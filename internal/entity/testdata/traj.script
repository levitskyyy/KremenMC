# Platforms 8 blocks apart, top surface at y=101 (stone), ice at x 20..28.
setup fill -8 100 -8 8 100 8 minecraft:stone
setup fill 20 100 -8 28 100 8 minecraft:ice
setup fill 40 100 -8 48 100 8 minecraft:blue_ice
setup fill 60 96 -8 68 100 8 minecraft:water
setup fill 60 95 -8 68 95 8 minecraft:stone
setup fill -8 100 20 8 100 28 minecraft:slime_block
setup fill 20 96 20 28 100 28 minecraft:lava
setup fill 20 95 20 28 95 28 minecraft:stone
